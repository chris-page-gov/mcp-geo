#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
APP_ROOT="/app"
IMAGE="${MCP_GEO_IMAGE:-mcp-geo-server}"
NETWORK="${MCP_GEO_DOCKER_NETWORK:-mcp-geo-sidecar}"
POSTGIS_CONTAINER="${MCP_GEO_POSTGIS_CONTAINER:-mcp-geo-postgis-sidecar}"
POSTGIS_IMAGE="${MCP_GEO_POSTGIS_IMAGE:-mcp-geo-postgis-pgrouting:16-3.4}"
POSTGIS_STORAGE_MODE="${MCP_GEO_POSTGIS_STORAGE_MODE:-volume}"
POSTGIS_VOLUME="${MCP_GEO_POSTGIS_VOLUME:-mcp-geo-postgis-sidecar}"
DATA_DIR="${MCP_GEO_POSTGIS_DATA_DIR:-$REPO_ROOT/data/postgres}"
LOG_DIR="${MCP_GEO_LOG_DIR:-$REPO_ROOT/logs}"
HOST_DATA_REPO_ROOT="${MCP_GEO_HOST_DATA_REPO_ROOT:-$REPO_ROOT}"
LANDIS_HOST_DATA_ROOT="${MCP_GEO_LANDIS_DATA_ROOT:-${LANDIS_LOCAL_DATA_ROOT:-$HOME/Data}}"
LANDIS_CONTAINER_DATA_ROOT="${MCP_GEO_LANDIS_CONTAINER_DATA_ROOT:-/landis-data}"
ONS_GEO_HOST_CACHE_DIR="${MCP_GEO_HOST_ONS_GEO_CACHE_DIR:-$HOST_DATA_REPO_ROOT/data/cache/ons_geo}"
ONS_GEO_CONTAINER_CACHE_DIR="${MCP_GEO_CONTAINER_ONS_GEO_CACHE_DIR:-/app/data/cache/ons_geo}"
ONS_GEO_HOST_CACHE_INDEX_PATH="${MCP_GEO_HOST_ONS_GEO_CACHE_INDEX_PATH:-$HOST_DATA_REPO_ROOT/resources/ons_geo_cache_index.json}"
ONS_GEO_CONTAINER_CACHE_INDEX_PATH="${MCP_GEO_CONTAINER_ONS_GEO_CACHE_INDEX_PATH:-/app/resources/ons_geo_cache_index.json}"
POSTGIS_PUBLISH_PORT="${MCP_GEO_POSTGIS_PUBLISH_PORT:-0}"
POSTGIS_PGDATA="${MCP_GEO_POSTGIS_PGDATA:-/var/lib/postgresql/data/pgdata}"
POSTGIS_PLATFORM="${MCP_GEO_POSTGIS_PLATFORM:-linux/amd64}"
POSTGIS_DOCKERFILE="${MCP_GEO_POSTGIS_DOCKERFILE:-$REPO_ROOT/.devcontainer/postgis.Dockerfile}"
POSTGIS_BUILD_CONTEXT="${MCP_GEO_POSTGIS_BUILD_CONTEXT:-$REPO_ROOT}"
POSTGIS_BUILD_MODE="${MCP_GEO_POSTGIS_BUILD:-missing}"
POSTGIS_REUSE_DEVCONTAINER="${MCP_GEO_POSTGIS_REUSE_DEVCONTAINER:-0}"
POSTGIS_REUSE_CONTAINER="${MCP_GEO_POSTGIS_REUSE_CONTAINER:-mcp-geo_devcontainer-postgis-1}"
DOCKER_BIN="${MCP_GEO_DOCKER_BIN:-}"
PYTHON_BIN="${MCP_GEO_PYTHON_BIN:-}"
TRACE_LOG="${MCP_STDIO_TRACE_LOG:-}"
BUILD_MODE="${MCP_GEO_DOCKER_BUILD:-missing}"
DOCKER_UI_EVENT_LOG_PATH="${MCP_GEO_DOCKER_UI_EVENT_LOG_PATH:-${UI_EVENT_LOG_PATH:-/logs/ui-events.jsonl}}"
ROUTE_GRAPH_ENABLED_VALUE="${ROUTE_GRAPH_ENABLED:-true}"
TRANSPORT_MODE="${MCP_GEO_DOCKER_TRANSPORT:-stdio}"
HTTP_BIND_HOST="${MCP_GEO_HTTP_HOST:-127.0.0.1}"
HTTP_PORT="${MCP_GEO_HTTP_PORT:-8000}"
HTTP_CONTAINER_PORT="${MCP_GEO_HTTP_CONTAINER_PORT:-8000}"
HTTP_CONTAINER_NAME="${MCP_GEO_HTTP_CONTAINER_NAME:-mcp-geo-http}"
HTTP_REPLACE_CONTAINER="${MCP_GEO_HTTP_REPLACE:-1}"
POSTGIS_HOST="${MCP_GEO_POSTGIS_HOST:-postgis}"
POSTGIS_TARGET_CONTAINER="$POSTGIS_CONTAINER"
MANAGE_POSTGIS_CONTAINER=true
PLAN_ONLY="${MCP_GEO_DOCKER_PLAN_ONLY:-0}"
LANDIS_MOUNT_ENABLED=false
ONS_DATASET_HOST_CACHE_DIR="${MCP_GEO_HOST_ONS_DATASET_CACHE_DIR:-$HOST_DATA_REPO_ROOT/data/cache/ons}"
ONS_DATASET_CONTAINER_CACHE_DIR="${MCP_GEO_CONTAINER_ONS_DATASET_CACHE_DIR:-/app/data/cache/ons}"
ONS_DATASET_CACHE_MOUNT_ENABLED=false
ONS_GEO_CACHE_MOUNT_ENABLED=false
ONS_GEO_CACHE_INDEX_MOUNT_ENABLED=false
OS_DATA_HOST_CACHE_DIR="${MCP_GEO_HOST_OS_DATA_CACHE_DIR:-$HOST_DATA_REPO_ROOT/data/cache/os}"
OS_DATA_CONTAINER_CACHE_DIR="${MCP_GEO_CONTAINER_OS_DATA_CACHE_DIR:-/app/data/cache/os}"
OS_DATA_CACHE_MOUNT_ENABLED=false
BOUNDARY_RUNS_MOUNT_ENABLED=false
BOUNDARY_RUNS_PRIMARY_HOST_PATH=""
BOUNDARY_RUNS_PRIMARY_CONTAINER_PATH=""
BOUNDARY_RUNS_SEARCH_HOST_PATHS=()
BOUNDARY_RUNS_SEARCH_CONTAINER_PATHS=()
ADDRESSBASE_XREF_HOST_PATH=""
ADDRESSBASE_XREF_CONTAINER_PATH=""

log() {
  printf "[mcp-geo] %s\n" "$*" >&2
}

lowercase() {
  printf "%s" "$1" | tr '[:upper:]' '[:lower:]'
}

is_truthy() {
  case "$(lowercase "$1")" in
    1|true|yes|on)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

is_auto_or_truthy() {
  case "$(lowercase "$1")" in
    auto|1|true|yes|on)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

trim_space() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf "%s" "$value"
}

append_readonly_mount_if_exists() {
  local source="$1"
  local target="${2:-$1}"
  [[ -n "$source" ]] || return 0
  if [[ ! -e "$source" ]]; then
    log "warning: requested mount path does not exist, skipping: $source"
    return 0
  fi
  mount_args+=(-v "$source:$target:ro")
}

resolve_host_path() {
  local raw="$1"
  if [[ "$raw" == "~" ]]; then
    raw="$HOME"
  elif [[ "$raw" == ~/* ]]; then
    raw="$HOME/${raw#~/}"
  elif [[ "$raw" =~ ^[A-Za-z]:[\\/].* ]]; then
    if command -v cygpath >/dev/null 2>&1; then
      cygpath -u "$raw"
      return 0
    fi
    local drive_letter="${raw:0:1}"
    local remainder="${raw:2}"
    remainder="/${remainder//\\//}"
    printf "/%s%s" "$(printf '%s' "$drive_letter" | tr '[:upper:]' '[:lower:]')" "$remainder"
    return 0
  fi
  if [[ "$raw" = /* ]]; then
    printf "%s" "$raw"
    return 0
  fi
  printf "%s" "$REPO_ROOT/$raw"
}

resolve_container_path() {
  local raw="$1"
  if [[ "$raw" =~ ^[A-Za-z]:[\\/].* ]]; then
    if command -v cygpath >/dev/null 2>&1; then
      cygpath -u "$raw"
      return 0
    fi
    local drive_letter="${raw:0:1}"
    local remainder="${raw:2}"
    remainder="/${remainder//\\//}"
    printf "/%s%s" "$(printf '%s' "$drive_letter" | tr '[:upper:]' '[:lower:]')" "$remainder"
    return 0
  fi
  if [[ "$raw" = /* ]]; then
    printf "%s" "$raw"
    return 0
  fi
  printf "%s" "$APP_ROOT/$raw"
}

append_readonly_mount_for_config_path() {
  local raw="$1"
  [[ -n "$raw" ]] || return 0
  append_readonly_mount_if_exists "$(resolve_host_path "$raw")" "$(resolve_container_path "$raw")"
}

dotenv_get() {
  local key="$1"
  local file="$2"
  [[ -f "$file" ]] || return 1
  awk -v k="$key" '
    /^[[:space:]]*#/ { next }
    {
      line = $0
      sub(/^[[:space:]]*export[[:space:]]+/, "", line)
      if (line !~ ("^[[:space:]]*" k "[[:space:]]*=")) {
        next
      }
      sub("^[[:space:]]*" k "[[:space:]]*=", "", line)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", line)
      if ((line ~ /^".*"$/) || (line ~ /^'\''.*'\''$/)) {
        line = substr(line, 2, length(line) - 2)
      }
      print line
      found = 1
    }
    END {
      if (!found) {
        exit 1
      }
    }
  ' "$file"
}

hydrate_env_secret() {
  local key="$1"
  local file_var="${key}_FILE"
  local value="${!key:-}"
  if [[ -n "$value" ]]; then
    return 0
  fi

  local file_path="${!file_var:-}"
  if [[ -n "$file_path" && -r "$file_path" ]]; then
    value="$(<"$file_path")"
    value="$(trim_space "$value")"
    if [[ -n "$value" ]]; then
      export "$key=$value"
      return 0
    fi
  fi

  if [[ "$(uname -s)" == "Darwin" ]] && command -v launchctl >/dev/null 2>&1; then
    value="$(launchctl getenv "$key" 2>/dev/null || true)"
    value="$(trim_space "$value")"
    if [[ -n "$value" ]]; then
      export "$key=$value"
      return 0
    fi
  fi

  local dotenv_file="${MCP_GEO_ENV_FILE:-$REPO_ROOT/.env}"
  value="$(dotenv_get "$key" "$dotenv_file" 2>/dev/null || true)"
  value="$(trim_space "$value")"
  if [[ -n "$value" ]]; then
    export "$key=$value"
    return 0
  fi
}

hydrate_env_value() {
  local key="$1"
  local value="${!key:-}"
  if [[ -n "$value" ]]; then
    return 0
  fi
  local dotenv_file="${MCP_GEO_ENV_FILE:-$REPO_ROOT/.env}"
  value="$(dotenv_get "$key" "$dotenv_file" 2>/dev/null || true)"
  value="$(trim_space "$value")"
  if [[ -n "$value" ]]; then
    export "$key=$value"
  fi
}

hydrate_env_values() {
  local key
  for key in "$@"; do
    hydrate_env_value "$key"
  done
}

parse_csv_values() {
  local raw="$1"
  local parts=()
  local part=""
  IFS=',' read -r -a parts <<< "$raw"
  for part in "${parts[@]}"; do
    part="$(trim_space "$part")"
    [[ -n "$part" ]] || continue
    printf "%s\n" "$part"
  done
}

wait_for_postgis() {
  local attempt
  for attempt in $(seq 1 30); do
    if "$DOCKER_BIN" exec "$POSTGIS_TARGET_CONTAINER" \
      pg_isready -U mcp_geo -d mcp_geo >/dev/null 2>&1; then
      return 0
    fi
    sleep 1
  done
  return 1
}

diagnose_postgis_failure() {
  [[ "$MANAGE_POSTGIS_CONTAINER" == "true" ]] || return 0
  "$DOCKER_BIN" container inspect "$POSTGIS_TARGET_CONTAINER" >/dev/null 2>&1 || return 0
  local recent_logs=""
  recent_logs="$("$DOCKER_BIN" logs --tail 80 "$POSTGIS_TARGET_CONTAINER" 2>&1 || true)"
  if [[ -z "$recent_logs" ]]; then
    return 0
  fi
  if command -v rg >/dev/null 2>&1; then
    if printf "%s" "$recent_logs" | rg -qi \
      'invalid checkpoint record|could not locate a valid checkpoint record'; then
      log "PostGIS volume appears checkpoint-corrupted for container: $POSTGIS_TARGET_CONTAINER"
      log "If this sidecar cache is disposable, recreate it with:"
      log "  docker rm -f $POSTGIS_TARGET_CONTAINER"
      if [[ "$POSTGIS_STORAGE_MODE" == "volume" ]]; then
        log "  docker volume rm $POSTGIS_VOLUME"
      fi
      log "The wrapper now defaults to per-surface sidecar names to avoid cross-client volume reuse."
      return 0
    fi
  elif printf "%s" "$recent_logs" | grep -Eqi \
    'invalid checkpoint record|could not locate a valid checkpoint record'; then
    log "PostGIS volume appears checkpoint-corrupted for container: $POSTGIS_TARGET_CONTAINER"
    log "If this sidecar cache is disposable, recreate it with:"
    log "  docker rm -f $POSTGIS_TARGET_CONTAINER"
    if [[ "$POSTGIS_STORAGE_MODE" == "volume" ]]; then
      log "  docker volume rm $POSTGIS_VOLUME"
    fi
    log "The wrapper now defaults to per-surface sidecar names to avoid cross-client volume reuse."
    return 0
  fi
  log "Recent PostGIS logs from $POSTGIS_TARGET_CONTAINER:"
  printf "%s\n" "$recent_logs" >&2
}

bootstrap_postgis_sql() {
  local sql_file="$1"
  local label="$2"
  [[ -f "$sql_file" ]] || return 0
  if "$DOCKER_BIN" exec -i "$POSTGIS_TARGET_CONTAINER" \
    psql -v ON_ERROR_STOP=1 -U mcp_geo -d mcp_geo >/dev/null 2>&1 < "$sql_file"; then
    return 0
  fi
  log "$label bootstrap failed; run: docker exec -i $POSTGIS_TARGET_CONTAINER psql -U mcp_geo -d mcp_geo < $sql_file"
  return 1
}

postgres_scalar() {
  local statement="$1"
  "$DOCKER_BIN" exec "$POSTGIS_TARGET_CONTAINER" \
    psql -U mcp_geo -d mcp_geo -tAc "$statement" 2>/dev/null || true
}

host_path_to_container() {
  local host_path="$1"
  printf "%s" "${host_path/#$LANDIS_HOST_DATA_ROOT/$LANDIS_CONTAINER_DATA_ROOT}"
}

first_existing_path() {
  local candidate
  for candidate in "$@"; do
    if [[ -e "$candidate" ]]; then
      printf "%s" "$candidate"
      return 0
    fi
  done
  return 1
}

latest_matching_dir() {
  local root="$1"
  local prefix="$2"
  local mode="${3:-}"
  local matches=()
  local candidate
  for candidate in "$root"/"$prefix"*; do
    [[ -d "$candidate" ]] || continue
    if [[ "$mode" == "exclude_smoke" && "$(basename "$candidate")" == *-smoke* ]]; then
      continue
    fi
    matches+=("$candidate")
  done
  if [[ "${#matches[@]}" -eq 0 ]]; then
    return 1
  fi
  printf "%s\n" "${matches[@]}" | LC_ALL=C sort | tail -n 1 | tr -d '\n'
}

matching_dirs() {
  local root="$1"
  local prefix="$2"
  local mode="${3:-}"
  local matches=()
  local candidate
  for candidate in "$root"/"$prefix"*; do
    [[ -d "$candidate" ]] || continue
    if [[ "$mode" == "exclude_smoke" && "$(basename "$candidate")" == *-smoke* ]]; then
      continue
    fi
    matches+=("$candidate")
  done
  if [[ "${#matches[@]}" -eq 0 ]]; then
    return 1
  fi
  printf "%s\n" "${matches[@]}" | LC_ALL=C sort
}

portal_archive_is_complete() {
  local host_path="$1"
  "$DOCKER_BIN" run --rm \
    --network "$NETWORK" \
    -v "$LANDIS_HOST_DATA_ROOT:$LANDIS_CONTAINER_DATA_ROOT:ro" \
    --entrypoint python \
    "$IMAGE" \
    scripts/landis_phase2_ingest.py \
    --validate-archive-root \
    --portal-archive-root "$(host_path_to_container "$host_path")" >/dev/null 2>&1
}

select_complete_matching_dir() {
  local root="$1"
  local prefix="$2"
  local mode="${3:-}"
  local candidates=()
  local candidate
  local idx

  while IFS= read -r candidate; do
    [[ -n "$candidate" ]] || continue
    candidates+=("$candidate")
  done < <(matching_dirs "$root" "$prefix" "$mode" || true)

  if [[ "${#candidates[@]}" -eq 0 ]]; then
    return 1
  fi

  for ((idx=${#candidates[@]} - 1; idx>=0; idx--)); do
    candidate="${candidates[$idx]}"
    if portal_archive_is_complete "$candidate"; then
      printf "%s" "$candidate"
      return 0
    fi
    log "Skipping incomplete LandIS portal archive: $candidate"
  done
  return 1
}

bootstrap_landis_runtime() {
  if [[ "$LANDIS_MOUNT_ENABLED" != "true" ]]; then
    return 0
  fi
  if ! is_truthy "${LANDIS_ENABLED:-true}"; then
    return 0
  fi
  if ! is_truthy "${LANDIS_LIVE_ENABLED:-true}"; then
    return 0
  fi

  local dsn="postgresql://mcp_geo:mcp_geo@${POSTGIS_HOST}:5432/mcp_geo"
  local product_count
  local natmap_count
  local nsi_site_count
  local soilscapes_count
  local pipe_risk_count
  product_count="$(trim_space "$(postgres_scalar "SELECT CASE WHEN to_regclass('landis.product_registry') IS NULL THEN '-1' ELSE (SELECT COUNT(*)::text FROM landis.product_registry) END;")")"
  natmap_count="$(trim_space "$(postgres_scalar "SELECT CASE WHEN to_regclass('landis.natmap_polygons') IS NULL THEN '-1' ELSE (SELECT COUNT(*)::text FROM landis.natmap_polygons) END;")")"
  nsi_site_count="$(trim_space "$(postgres_scalar "SELECT CASE WHEN to_regclass('landis.nsi_sites') IS NULL THEN '-1' ELSE (SELECT COUNT(*)::text FROM landis.nsi_sites) END;")")"
  soilscapes_count="$(trim_space "$(postgres_scalar "SELECT CASE WHEN to_regclass('landis.soilscapes_polygons') IS NULL THEN '-1' ELSE (SELECT COUNT(*)::text FROM landis.soilscapes_polygons) END;")")"
  pipe_risk_count="$(trim_space "$(postgres_scalar "SELECT CASE WHEN to_regclass('landis.pipe_risk_polygons') IS NULL THEN '-1' ELSE (SELECT COUNT(*)::text FROM landis.pipe_risk_polygons) END;")")"

  local need_phase2=false
  local need_validation=false
  if [[ -z "$product_count" || "$product_count" == "-1" || "$product_count" == "0" || "$natmap_count" == "-1" || "$natmap_count" == "0" || "$nsi_site_count" == "-1" || "$nsi_site_count" == "0" ]]; then
    need_phase2=true
  fi
  if [[ -z "$product_count" || "$product_count" == "-1" || "$product_count" == "0" || "$soilscapes_count" == "-1" || "$soilscapes_count" == "0" || "$pipe_risk_count" == "-1" || "$pipe_risk_count" == "0" ]]; then
    need_validation=true
  fi
  if [[ "$need_phase2" != "true" && "$need_validation" != "true" ]]; then
    return 0
  fi

  bootstrap_postgis_sql "$REPO_ROOT/scripts/landis_schema.sql" "landis" || true

  local mount_args=(-v "$LANDIS_HOST_DATA_ROOT:$LANDIS_CONTAINER_DATA_ROOT:ro")
  if [[ "$need_phase2" == "true" ]]; then
    local portal_archive_host=""
    portal_archive_host="$(select_complete_matching_dir \
      "$LANDIS_HOST_DATA_ROOT" \
      "landis_portal_archive_" \
      "exclude_smoke")" || true
    if [[ -z "$portal_archive_host" ]]; then
      portal_archive_host="$(select_complete_matching_dir \
        "$LANDIS_HOST_DATA_ROOT" \
        "landis_portal_archive_")" || true
    fi
    if [[ -n "$portal_archive_host" ]]; then
      log "bootstrapping LandIS NATMAP and NSI archive tables"
      "$DOCKER_BIN" run --rm \
        --network "$NETWORK" \
        "${mount_args[@]}" \
        --entrypoint python \
        "$IMAGE" \
        scripts/landis_phase2_ingest.py \
        --dsn "$dsn" \
        --portal-archive-root "$(host_path_to_container "$portal_archive_host")" >&2
    else
      log "LandIS portal archive not found under $LANDIS_HOST_DATA_ROOT; skipping NATMAP/NSI bootstrap."
    fi
  fi

  if [[ "$need_validation" == "true" ]]; then
    local soilscapes_host=""
    local pipe_risk_host=""
    local ingest_args=()
    soilscapes_host="$(first_existing_path \
      "$LANDIS_HOST_DATA_ROOT/landis_warwickshire_validation/soilscapes_warwickshire_normalized.geojson" \
      "$LANDIS_HOST_DATA_ROOT/landis_warwickshire_validation/official/landis_official_soilscapes_warwickshire.geojson")" || true
    pipe_risk_host="$(first_existing_path \
      "$LANDIS_HOST_DATA_ROOT/landis_warwickshire_validation/official/landis_official_pipe_risk_warwickshire.geojson")" || true
    if [[ -n "$soilscapes_host" ]]; then
      ingest_args+=(--soilscapes "$(host_path_to_container "$soilscapes_host")")
    fi
    if [[ -n "$pipe_risk_host" ]]; then
      ingest_args+=(--pipe-risk "$(host_path_to_container "$pipe_risk_host")")
    fi
    if [[ "${#ingest_args[@]}" -gt 0 ]]; then
      log "bootstrapping LandIS Soilscapes and validation pipe-risk layers"
      "$DOCKER_BIN" run --rm \
        --network "$NETWORK" \
        "${mount_args[@]}" \
        --entrypoint python \
        "$IMAGE" \
        scripts/landis_ingest.py \
        --dsn "$dsn" \
        "${ingest_args[@]}" \
        --dataset-version 2026-warwickshire-validation \
        --source-url https://www.landis.org.uk/soilscapes/ \
        --license-name "LandIS validation extract" >&2
    else
      log "LandIS Soilscapes/pipe-risk validation files not found under $LANDIS_HOST_DATA_ROOT; skipping validation bootstrap."
    fi
  fi
}

detect_reusable_devcontainer_postgis() {
  local network_name=""
  local mode
  mode="$(lowercase "$POSTGIS_REUSE_DEVCONTAINER")"
  if ! is_auto_or_truthy "$mode"; then
    return 1
  fi
  if ! "$DOCKER_BIN" container inspect "$POSTGIS_REUSE_CONTAINER" >/dev/null 2>&1; then
    if is_truthy "$mode"; then
      log "Configured PostGIS reuse container not found: $POSTGIS_REUSE_CONTAINER"
      exit 1
    fi
    return 1
  fi
  if [[ "$("$DOCKER_BIN" container inspect -f '{{.State.Running}}' "$POSTGIS_REUSE_CONTAINER" 2>/dev/null || true)" != "true" ]]; then
    if is_truthy "$mode"; then
      log "Configured PostGIS reuse container is not running: $POSTGIS_REUSE_CONTAINER"
      exit 1
    fi
    return 1
  fi
  network_name="$("$DOCKER_BIN" container inspect -f '{{range $name, $_ := .NetworkSettings.Networks}}{{println $name}}{{end}}' "$POSTGIS_REUSE_CONTAINER" 2>/dev/null | head -n 1 | tr -d '\r')"
  if [[ -z "$network_name" ]]; then
    if is_truthy "$mode"; then
      log "Unable to discover Docker network for $POSTGIS_REUSE_CONTAINER"
      exit 1
    fi
    return 1
  fi
  NETWORK="$network_name"
  POSTGIS_TARGET_CONTAINER="$POSTGIS_REUSE_CONTAINER"
  MANAGE_POSTGIS_CONTAINER=false
  POSTGIS_HOST="${MCP_GEO_POSTGIS_HOST:-postgis}"
  log "reusing devcontainer PostGIS container: $POSTGIS_TARGET_CONTAINER on network $NETWORK"
  return 0
}

emit_plan() {
  local boundary_search_host_paths=""
  local boundary_search_container_paths=""
  boundary_search_host_paths="$(IFS=,; printf "%s" "${BOUNDARY_RUNS_SEARCH_HOST_PATHS[*]-}")"
  boundary_search_container_paths="$(IFS=,; printf "%s" "${BOUNDARY_RUNS_SEARCH_CONTAINER_PATHS[*]-}")"
  printf 'postgis_target_container=%s\n' "$POSTGIS_TARGET_CONTAINER"
  printf 'postgis_host=%s\n' "$POSTGIS_HOST"
  printf 'manage_postgis_container=%s\n' "$MANAGE_POSTGIS_CONTAINER"
  printf 'network=%s\n' "$NETWORK"
  printf 'postgis_container_name=%s\n' "$POSTGIS_CONTAINER"
  printf 'postgis_image=%s\n' "$POSTGIS_IMAGE"
  printf 'postgis_storage_mode=%s\n' "$POSTGIS_STORAGE_MODE"
  printf 'postgis_volume=%s\n' "$POSTGIS_VOLUME"
  printf 'postgis_publish_port=%s\n' "$POSTGIS_PUBLISH_PORT"
  printf 'postgis_reuse_devcontainer=%s\n' "$POSTGIS_REUSE_DEVCONTAINER"
  printf 'host_data_repo_root=%s\n' "$HOST_DATA_REPO_ROOT"
  printf 'transport_mode=%s\n' "$TRANSPORT_MODE"
  printf 'http_bind_host=%s\n' "$HTTP_BIND_HOST"
  printf 'http_port=%s\n' "$HTTP_PORT"
  printf 'http_container_port=%s\n' "$HTTP_CONTAINER_PORT"
  printf 'http_container_name=%s\n' "$HTTP_CONTAINER_NAME"
  printf 'http_replace_container=%s\n' "$HTTP_REPLACE_CONTAINER"
  printf 'landis_host_data_root=%s\n' "$LANDIS_HOST_DATA_ROOT"
  printf 'landis_container_data_root=%s\n' "$LANDIS_CONTAINER_DATA_ROOT"
  printf 'landis_mount_enabled=%s\n' "$LANDIS_MOUNT_ENABLED"
  printf 'os_api_key_present=%s\n' "$([[ -n "${OS_API_KEY:-}" ]] && printf true || printf false)"
  printf 'os_api_key_file_present=%s\n' "$([[ -n "${OS_API_KEY_FILE:-}" ]] && printf true || printf false)"
  printf 'default_toolset=%s\n' "${MCP_TOOLS_DEFAULT_TOOLSET:-}"
  printf 'include_toolsets=%s\n' "${MCP_TOOLS_DEFAULT_INCLUDE_TOOLSETS:-}"
  printf 'exclude_toolsets=%s\n' "${MCP_TOOLS_DEFAULT_EXCLUDE_TOOLSETS:-}"
  printf 'mcp_2026_rc_enabled=%s\n' "${MCP_2026_RC_ENABLED:-}"
  printf 'mcp_protocol_2026_07_28_enabled=%s\n' "${MCP_PROTOCOL_2026_07_28_ENABLED:-}"
  printf 'mcp_http_auth_mode=%s\n' "${MCP_HTTP_AUTH_MODE:-}"
  printf 'mcp_http_auth_token_present=%s\n' "$([[ -n "${MCP_HTTP_AUTH_TOKEN:-}" ]] && printf true || printf false)"
  printf 'mcp_http_jwt_hs256_secret_present=%s\n' "$([[ -n "${MCP_HTTP_JWT_HS256_SECRET:-}" ]] && printf true || printf false)"
  printf 'addressbase_xref_host_path=%s\n' "$ADDRESSBASE_XREF_HOST_PATH"
  printf 'addressbase_xref_container_path=%s\n' "$ADDRESSBASE_XREF_CONTAINER_PATH"
  printf 'ons_dataset_host_cache_dir=%s\n' "$ONS_DATASET_HOST_CACHE_DIR"
  printf 'ons_dataset_container_cache_dir=%s\n' "$ONS_DATASET_CONTAINER_CACHE_DIR"
  printf 'ons_dataset_cache_mount_enabled=%s\n' "$ONS_DATASET_CACHE_MOUNT_ENABLED"
  printf 'ons_geo_host_cache_dir=%s\n' "$ONS_GEO_HOST_CACHE_DIR"
  printf 'ons_geo_container_cache_dir=%s\n' "$ONS_GEO_CONTAINER_CACHE_DIR"
  printf 'ons_geo_cache_mount_enabled=%s\n' "$ONS_GEO_CACHE_MOUNT_ENABLED"
  printf 'ons_geo_host_cache_index_path=%s\n' "$ONS_GEO_HOST_CACHE_INDEX_PATH"
  printf 'ons_geo_container_cache_index_path=%s\n' "$ONS_GEO_CONTAINER_CACHE_INDEX_PATH"
  printf 'ons_geo_cache_index_mount_enabled=%s\n' "$ONS_GEO_CACHE_INDEX_MOUNT_ENABLED"
  printf 'os_data_host_cache_dir=%s\n' "$OS_DATA_HOST_CACHE_DIR"
  printf 'os_data_container_cache_dir=%s\n' "$OS_DATA_CONTAINER_CACHE_DIR"
  printf 'os_data_cache_mount_enabled=%s\n' "$OS_DATA_CACHE_MOUNT_ENABLED"
  printf 'boundary_runs_mount_enabled=%s\n' "$BOUNDARY_RUNS_MOUNT_ENABLED"
  printf 'boundary_runs_primary_host_path=%s\n' "$BOUNDARY_RUNS_PRIMARY_HOST_PATH"
  printf 'boundary_runs_primary_container_path=%s\n' "$BOUNDARY_RUNS_PRIMARY_CONTAINER_PATH"
  printf 'boundary_runs_search_host_paths=%s\n' "$boundary_search_host_paths"
  printf 'boundary_runs_search_container_paths=%s\n' "$boundary_search_container_paths"
}

ensure_postgis_image() {
  local should_build=false
  case "$POSTGIS_BUILD_MODE" in
    always)
      should_build=true
      ;;
    missing)
      if ! "$DOCKER_BIN" image inspect "$POSTGIS_IMAGE" >/dev/null 2>&1; then
        should_build=true
      fi
      ;;
    never)
      should_build=false
      ;;
    *)
      log "unknown MCP_GEO_POSTGIS_BUILD mode: $POSTGIS_BUILD_MODE (use always|missing|never)"
      exit 1
      ;;
  esac
  if [[ "$should_build" != "true" ]]; then
    return 0
  fi
  if [[ ! -f "$POSTGIS_DOCKERFILE" ]]; then
    log "PostGIS Dockerfile not found: $POSTGIS_DOCKERFILE"
    exit 1
  fi
  log "building PostGIS image: $POSTGIS_IMAGE"
  "$DOCKER_BIN" build \
    --platform "$POSTGIS_PLATFORM" \
    -t "$POSTGIS_IMAGE" \
    -f "$POSTGIS_DOCKERFILE" \
    "$POSTGIS_BUILD_CONTEXT" >&2
}

if [[ -z "$DOCKER_BIN" ]]; then
  for candidate in /usr/local/bin/docker /opt/homebrew/bin/docker /usr/bin/docker; do
    if [[ -x "$candidate" ]]; then
      DOCKER_BIN="$candidate"
      break
    fi
  done
fi
if [[ -z "$DOCKER_BIN" ]] && command -v docker >/dev/null 2>&1; then
  DOCKER_BIN="$(command -v docker)"
fi
if [[ -z "$DOCKER_BIN" || ! -x "$DOCKER_BIN" ]]; then
  log "docker is required but was not found (set MCP_GEO_DOCKER_BIN to its path)."
  exit 1
fi

if ! "$DOCKER_BIN" info >/dev/null 2>&1; then
  log "docker is installed but not running. Start Docker Desktop and retry."
  exit 1
fi

