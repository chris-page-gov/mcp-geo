if [[ "$TRANSPORT_MODE" == "http" ]]; then
  if "$DOCKER_BIN" container inspect "$HTTP_CONTAINER_NAME" >/dev/null 2>&1; then
    if is_truthy "$HTTP_REPLACE_CONTAINER"; then
      log "replacing existing HTTP demo container: $HTTP_CONTAINER_NAME"
      "$DOCKER_BIN" rm -f "$HTTP_CONTAINER_NAME" >/dev/null
    else
      log "HTTP demo container already exists: $HTTP_CONTAINER_NAME"
      exit 1
    fi
  fi

  docker_args=(
    run -d --rm
    --name "$HTTP_CONTAINER_NAME"
    --network "$NETWORK"
    -p "${HTTP_BIND_HOST}:${HTTP_PORT}:${HTTP_CONTAINER_PORT}"
    "${mount_args[@]}"
    "${env_args[@]}"
    "$IMAGE"
    uvicorn server.main:app --host 0.0.0.0 --port "$HTTP_CONTAINER_PORT"
  )

  "$DOCKER_BIN" "${docker_args[@]}"
  log "MCP HTTP server running at http://${HTTP_BIND_HOST}:${HTTP_PORT}/mcp"
  log "container: $HTTP_CONTAINER_NAME"
  exit 0
fi

docker_args=(
  run --rm -i
  --network "$NETWORK"
  "${mount_args[@]}"
  "${env_args[@]}"
  "$IMAGE"
)

if [[ -n "$TRACE_LOG" ]]; then
  if [[ -z "$PYTHON_BIN" ]]; then
    for candidate in /usr/bin/python3 /opt/homebrew/bin/python3 /usr/local/bin/python3; do
      if [[ -x "$candidate" ]]; then
        PYTHON_BIN="$candidate"
        break
      fi
    done
  fi
  if [[ -z "$PYTHON_BIN" ]] && command -v python3 >/dev/null 2>&1; then
    PYTHON_BIN="$(command -v python3)"
  fi
  if [[ -z "$PYTHON_BIN" || ! -x "$PYTHON_BIN" ]]; then
    log "python3 not found (set MCP_GEO_PYTHON_BIN to override)."
    exit 1
  fi
  exec "$PYTHON_BIN" "$REPO_ROOT/scripts/mcp_stdio_trace_proxy.py" --log "$TRACE_LOG" -- \
    "$DOCKER_BIN" "${docker_args[@]}"
fi

exec "$DOCKER_BIN" "${docker_args[@]}"
